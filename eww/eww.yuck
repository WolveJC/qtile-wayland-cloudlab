;; Variables dinámicas que actualiza Qtile mediante hooks
(defvar var_groups '[{"name":"1","label":"1","focused":true,"occupied":false}]')
(defvar var_window "")
;; Paleta de colores en vivo. Qtile la actualiza con 'eww update' (NUNCA con
;; 'eww reload'): así el widget no se destruye/reconstruye en cada cambio de grupo,
;; y la transición CSS de eww.scss puede animar de verdad entre el color viejo y
;; el nuevo -- un 'eww reload' recompila y recrea toda la ventana desde cero, sin
;; ningún "antes" del que GTK pueda interpolar, y de paso causa un parpadeo visible.
(defvar var_palette '{"bg":"#1e1e2e","bg_alt":"#313244","text":"#cdd6f4","text_dim":"#a6adc8","accent":"#89b4fa","accent2":"#f38ba8","border_normal":"#45475a"}')

;; Ventana Principal del Panel
(defwindow bar
:monitor 0
:geometry (geometry :x "0%"
:y "0%"
:width "100%"
:height "32px"
:anchor "top center")
:stacking "fg"
:exclusive true
:focusable false
(bar_layout))

;; Layout del Contenedor
(defwidget bar_layout []
(box :class "bar-container"
:style "background-color: ${var_palette.bg}; color: ${var_palette.text};"
:orientation "h"
:space-evenly false
(workspaces)
(window_title)
;; Espacio a la derecha (reservado para reloj/systray en futuros módulos)
(box :hexpand true :halign "end")))

;; Widget de Grupos / Workspaces
(defwidget workspaces []
(box :class "workspaces"
:orientation "h"
:space-evenly false
:spacing 4
(for g in var_groups
(button :class "ws-btn"
:style "background-color: ${g.focused ? var_palette.accent : (g.occupied ? var_palette.bg_alt : 'transparent')}; color: ${g.focused ? var_palette.bg_alt : (g.occupied ? var_palette.text : var_palette.text_dim)}; font-weight: ${g.focused ? 'bold' : 'normal'};"
:onclick "qtile cmd-obj -o group ${g.name} -f toscreen"
"${g.label}"))))

;; Widget de Título de la Ventana Activa
(defwidget window_title []
(box :class "window-title"
:style "color: ${var_palette.accent2};"
:visible {var_window != ""}
(label :text var_window
:limit-width 50)))
